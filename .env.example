# ==============================================================================
# ARAV INNOVATIONS — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local and fill in the production / staging values.
# NEVER commit .env.local to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth Configuration (Phase 1)
# ------------------------------------------------------------------------------
# Project URL from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon API key (Safe for client browser, subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Secret Service Role Key (SERVER-SIDE ONLY — NEVER expose to browser)
# Used for server-side lead persistence and admin operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Vercel Storage & Blob Configuration
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here
NEXT_PUBLIC_VERCEL_BLOGS_URL=https://your-blob-store.public.blob.vercel-storage.com/blogs/index.json

# ------------------------------------------------------------------------------
# 3. Email Notification Configuration (Nodemailer / Resend)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM=noreply@aravinnovations.com
RESEND_API_KEY=re_your_resend_key_here

# ------------------------------------------------------------------------------
# 4. Analytics & SEO
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# ------------------------------------------------------------------------------
# 5. Environment Flags
# ------------------------------------------------------------------------------
VERCEL_ENVIRONMENT=development
